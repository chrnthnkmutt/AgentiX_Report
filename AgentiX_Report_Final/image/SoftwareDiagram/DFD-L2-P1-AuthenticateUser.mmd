---
flowchart TB
    User["User"] -- email + password --> P11["1.1 Receive Credentials"]
    P11 -- credentials --> P12["1.2 Validate Credentials"]
    P12 -- lookup user --> D1[("Users")]
    D1 -- user record --> P12
    P12 -- valid/invalid --> P15["1.5 Return Auth Result"]
    P12 -- user id --> P13["1.3 Fetch User Profile"]
    P13 -- read profile --> D1
    D1 -- profile --> P13
    P13 -- session data --> P14["1.4 Create Session / Token"]
    P14 -- token/session --> P15
    P15 -- auth result + role --> User
    P12 -- auth attempt --> P16["1.6 Log Auth Event"]
    P16 -- write log --> D6[("Audit Logs")]